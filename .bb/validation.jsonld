    ],
    "value_less_rows_finding": {
      "status": "RESOLVED_RECOVERED",
      "before": "648,298 rows (20.08%) had all of Ki/Kd/IC50/EC50 null",
      "after": "2,943 rows (0.09%) genuinely value-less",
      "root_cause": "stages/02_build.py coerced affinity columns with pd.to_numeric(errors='coerce'), which silently nulled BindingDB's censored values (e.g. '>100000', '<0.03'). Only '<' and '>' qualifiers occur; all strip cleanly to a float.",
      "fix": "parse_affinity() now splits each affinity cell into a numeric magnitude (ki_nm/ic50_nm/kd_nm/ec50_nm) plus a relation qualifier ('='/'<'/'>') stored in new columns ki_relation/ic50_relation/kd_relation/ec50_relation. This recovers 645,355 previously-dropped measurements without losing the censoring direction.",
      "recovered": 645355,
      "genuine_value_less": 2943,
      "decision": "kept + flagged via new boolean has_affinity column (False for the 2,943 genuinely value-less rows); no rows dropped. relation qualifier distribution across all measures: '=' exact majority, '>' ~lower-bound/inactive, '<' ~upper-bound/potent."
    },
