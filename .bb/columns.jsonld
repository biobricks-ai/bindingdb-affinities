{
  "@context": {
    "@vocab": "https://schema.org/",
    "cheminf": "http://semanticscience.org/resource/",
    "obo": "http://purl.obolibrary.org/obo/",
    "bao": "http://www.bioassayontology.org/bao#"
  },
  "columns": [
    {
      "name": "smiles",
      "@type": "cheminf:CHEMINF_000018",
      "description": "Ligand SMILES",
      "dataType": "string"
    },
    {
      "name": "inchi",
      "@type": "cheminf:CHEMINF_000113",
      "description": "Ligand InChI",
      "dataType": "string"
    },
    {
      "name": "inchikey",
      "@type": "cheminf:CHEMINF_000059",
      "description": "Ligand InChI Key",
      "dataType": "string"
    },
    {
      "name": "target_name",
      "description": "Name of the target protein",
      "dataType": "string"
    },
    {
      "name": "target_sequence",
      "description": "Amino acid sequence of the target",
      "dataType": "string"
    },
    {
      "name": "ki_nm",
      "description": "Ki binding affinity magnitude (censored values parsed; sign in ki_relation)",
      "unitCode": "nM",
      "dataType": "float"
    },
    {
      "name": "ic50_nm",
      "@type": "obo:OBI_0001173",
      "description": "IC50 binding affinity magnitude (censored values parsed; sign in ic50_relation)",
      "unitCode": "nM",
      "dataType": "float"
    },
    {
      "name": "kd_nm",
      "description": "Kd dissociation constant magnitude (censored values parsed; sign in kd_relation)",
      "unitCode": "nM",
      "dataType": "float"
    },
    {
      "name": "ec50_nm",
      "@type": "obo:OBI_0001174",
      "description": "EC50 effective concentration magnitude (censored values parsed; sign in ec50_relation)",
      "unitCode": "nM",
      "dataType": "float"
    },
    {
      "name": "ki_relation",
      "description": "Qualifier for ki_nm: '=' exact, '<' upper bound (more potent), '>' lower bound (less potent), null when no Ki",
      "dataType": "string"
    },
    {
      "name": "ic50_relation",
      "description": "Qualifier for ic50_nm: '=' exact, '<' upper bound, '>' lower bound, null when no IC50",
      "dataType": "string"
    },
    {
      "name": "kd_relation",
      "description": "Qualifier for kd_nm: '=' exact, '<' upper bound, '>' lower bound, null when no Kd",
      "dataType": "string"
    },
    {
      "name": "ec50_relation",
      "description": "Qualifier for ec50_nm: '=' exact, '<' upper bound, '>' lower bound, null when no EC50",
      "dataType": "string"
    },
    {
      "name": "kon",
      "description": "Association rate constant (Kon)",
      "unitCode": "1/Ms",
      "dataType": "float"
    },
    {
      "name": "koff",
      "description": "Dissociation rate constant (Koff)",
      "unitCode": "1/s",
      "dataType": "float"
    },
    {
      "name": "ph",
      "description": "pH of the assay",
      "dataType": "float"
    },
    {
      "name": "temp_c",
      "description": "Temperature in Celsius",
      "unitCode": "C",
      "dataType": "float"
    },
    {
      "name": "pubmed_id",
      "description": "PubMed ID of the source publication",
      "dataType": "string"
    },
    {
      "name": "pubchem_cid",
      "description": "PubChem Compound ID",
      "dataType": "integer"
    },
    {
      "name": "uniprot_id",
      "description": "UniProt ID of the target",
      "dataType": "string"
    },
    {
      "name": "has_affinity",
      "description": "True when at least one of Ki/Kd/IC50/EC50 has a value (censored or exact); False for the ~0.09% of rows genuinely lacking any affinity in BindingDB",
      "dataType": "boolean"
    }
  ]
}
